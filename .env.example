# ---------------------------------------------------------------------------
# Environment variables. Copy to `.env.local` for local development; production
# sets these in the server environment. Never commit real values.
# ---------------------------------------------------------------------------

# Public origin, no trailing slash. MUST match the port you serve on locally, or
# every admin write is refused as cross-origin. Production: https://cms-demo.gr
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Google Analytics 4 (G-XXXXXXXXXX). Blank disables analytics. Can also be set
# in Admin → Settings.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Analytics & Marketing (Admin → Settings → Analytics & Marketing) ─────────
# The IDs (GA4, GTM, Meta Pixel, Google Ads) are set in the admin. Only the
# server-side secrets live here — never in git, the admin or an export.
# Meta Conversions API token (Events Manager → Settings → Conversions API).
# Blank = no server-side events.
META_CAPI_ACCESS_TOKEN=
# Country code for phone numbers typed without one (hashed for the Conversions API).
META_CAPI_PHONE_COUNTRY_CODE=30
# GA4 Measurement Protocol API secret (GA4 → Admin → Data streams → the stream →
# Measurement Protocol API secrets). Used for refunds recorded in the admin.
GA4_MP_API_SECRET=

# ── Database (MariaDB/MySQL) ────────────────────────────────────────────────
# Create an empty schema, then `npm run db:migrate`.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/cms_demo_cms
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=cms_demo_cms

# ── Admin ───────────────────────────────────────────────────────────────────
# Session signing secret:  openssl rand -base64 48
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=60
# Encrypts stored API tokens and integration secrets (Google, couriers):
#   openssl rand -base64 48
CMS_TOKEN_ENCRYPTION_KEY=
# Admin route prefix (letters, digits, - and _).
ADMIN_PATH=admin
# reCAPTCHA v2 — admin login, and the public forms when Settings → Security →
# "Captcha on public forms" is on. These are Google's public TEST keys: every
# token passes, which is what dev and the automated tests should run with.
# They are REFUSED in production (treated as unset, logged as an error).
# Production: create a reCAPTCHA v2 "I'm not a robot" pair at
# https://www.google.com/recaptcha/admin, register BOTH the apex domain and
# www, and set the pair in the server's .env (never in git, never in the admin).
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Break-glass: exactly 6 digits that stand in for ANY admin's second factor, after a
# correct password. Active in EVERY environment, production included, whenever set
# (throttled: 5 tries/hour per IP and per account). Blank or malformed = off.
# Leave blank unless you need it, and clear it again afterwards.
ADMIN_MFA_BYPASS_CODE=

# ── Email (Microsoft Graph) — form notifications ────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_ADDRESS=
# The inbox form submissions are sent to.
CONTACT_RECIPIENT_EMAIL=

# ── Payments (only the methods ticked in Admin → Settings are used) ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_ENV=demo
VIVA_MERCHANT_ID=
VIVA_API_KEY=
VIVA_WEBHOOK_VERIFICATION_KEY=
# Klarna — its own API (Payments + Hosted Payment Page), never through Stripe.
# API username/password from the Klarna Merchant Portal. `live` only when set.
KLARNA_USERNAME=
KLARNA_PASSWORD=
KLARNA_ENV=playground
KLARNA_PURCHASE_COUNTRY=GR

# ── Google Business Profile (reviews) ───────────────────────────────────────
# Only for the OAuth connection in Settings → Integrations → Google reviews.
# The Places API key and the refresh token are stored encrypted in the database,
# not here. Google must also approve access to the Business Profile API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Gift cards ──────────────────────────────────────────────────────────────
# Peppers the stored gift card code hashes. At least 32 characters, and NEVER
# changed on a live shop: every existing card becomes unusable if it is.
#   openssl rand -base64 48
CMS_GIFTCARD_PEPPER=

# ── Couriers ────────────────────────────────────────────────────────────────
# BoxNow's sandbox is the default; set this to the production URL when the
# contract is live. The client id and secret are entered in the admin and stored
# encrypted, not here.
BOXNOW_API_URL=

# ── Scheduled jobs — shared secrets for the cron endpoints ──────────────────
# POST /api/cms/cron/<job> with header `x-cron-secret`. At least 32 characters;
# unset refuses every call. The legacy BOOKING_CRON_SECRET and
# COMMERCE_CRON_SECRET below follow the same 32-character minimum. Jobs: commerce-stale-orders (hourly),
# commerce-abandoned-reminders (every 15 min).   openssl rand -base64 48
CMS_CRON_SECRET=
BOOKING_CRON_SECRET=
COMMERCE_CRON_SECRET=
COMMERCE_ABANDONED_DELAY_MINUTES=
COMMERCE_ABANDONED_DAILY_MAX=

# ── Media uploads (default .data/uploads) ───────────────────────────────────
CMS_UPLOAD_DIR=

# ── Contact-form attachments (Settings → Forms; default .data/form-uploads) ──
# Visitor files, kept outside the webroot and served only by the admin's
# download. Optional virus scan through clamd: a Unix socket, or host [+ port].
# Once set, a file the scanner cannot check is refused (fail closed).
CMS_FORM_UPLOADS_DIR=
CLAMD_SOCKET=
CLAMD_HOST=
CLAMD_PORT=

# ── Export / Import staging (default .data/transfers, 2 GiB, 24 h) ──────────
# Packages can hold customer data: keep it outside the webroot and schedule the
# `transfer-cleanup` cron job.
CMS_TRANSFER_DIR=
CMS_TRANSFER_MAX_BYTES=
CMS_TRANSFER_TTL_HOURS=

# ── Edit locks (realtime; `npm run locks`) ──────────────────────────────────
CMS_LOCK_INTERNAL_SECRET=
CMS_LOCK_WS_PORT=8081
CMS_LOCK_WS_HOST=127.0.0.1
CMS_APP_ORIGIN=http://127.0.0.1:3002
CMS_LOCK_ALLOWED_ORIGIN=
CMS_LOCK_TTL_SECONDS=60
NEXT_PUBLIC_CMS_LOCK_WS_URL=
